{
  "manifest_version": 3,
  "name": "NotebookLM Podcast Sync",
  "version": "0.3.0",
  "description": "Turn your NotebookLM Audio Overviews into a personal podcast RSS feed pushed to your own GitHub repo.",
  "permissions": ["activeTab", "storage", "downloads", "scripting"],
  "host_permissions": [
    "https://notebooklm.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.googleapis.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "NotebookLM Podcast Sync"
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://notebooklm.google.com/notebook/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
