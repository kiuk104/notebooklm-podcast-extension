{
  "manifest_version": 3,
  "name": "NotebookLM Podcast Sync",
  "version": "0.4.48",
  "description": "Turn your NotebookLM Audio Overviews into a personal podcast RSS feed pushed to your own GitHub repo.",
  "permissions": ["activeTab", "storage", "downloads", "scripting", "alarms", "debugger", "offscreen", "notifications"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://notebooklm.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.usercontent.google.com/*",
    "https://*.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://lh3.google.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "NotebookLM Podcast Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://notebooklm.google.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
